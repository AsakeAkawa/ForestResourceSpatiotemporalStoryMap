# =========================================================================
# 2. 新增：Node.js & 前端通用配置 (彻底解决 node_modules 暴露问题)
# =========================================================================

# 核心依赖包（禁止追踪最外层和子目录下的 node_modules）
node_modules/
**/node_modules/

# 各种前端包管理器的日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 前端编译与测试缓存
.eslintcache
.stylelintcache
*.tsbuildinfo
*.timestamp-*-*.mjs

# 系统与编辑器缓存
.DS_Store
Thumbs.db

# =========================================================================
# 3. 新增：GIS 空间分析、遥感影像与大数据建模拦截 (防止误传大文件)
# =========================================================================

# 3.1 遥感影像与栅格切片（防止好几个G的原始大 TIFF/IMG 塞爆仓库）
*.tif
*.tiff
*.img
*.HDF5
*.nc
/public/tiles/
/src/assets/raw_tiles/

# 3.2 传统 GIS 矢量数据临时缓存与空间索引（Shapefile 伴生文件）
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.fbn
*.fbx
*.ain
*.aih
*.ixs
*.mxs
*.atlx

# 3.3 科研数据与数据分析备份（防 R 语言、Excel 大数据集误传）
*.RData
*.Rhistory
*.xlsx
*.xls

# 3.4 专用本地大数据存放区（建议把本地做实验的大数据都丢到这个目录下）
/src/assets/raw_data/
/public/data/large/